# Copy to .env. Keep the actual file out of Git and restrict it to the deployment user.
POSTGRES_DB=mulgil
POSTGRES_USER=mulgil
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD

# For an NPM instance in another LXC, set this to this backend LXC's LAN IPv4 and allow only NPM to reach it.
# Keep 127.0.0.1 only when the reverse proxy runs in this same LXC.
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8080
BACKEND_IMAGE=mulgil-backend:local
SPRING_PROFILES_ACTIVE=
# Optional override. Leave commented to use the active Spring profile default.
# CORS_ALLOWED_ORIGIN_PATTERNS=https://study.mulgil.app,https://web-git-*-jungy2kyung-6444s-projects.vercel.app

# Absolute host path to the dedicated backend service-account key JSON used for GCS signed URLs.
GOOGLE_APPLICATION_CREDENTIALS_FILE=/srv/mulgil/secrets/google-application-credentials.json
GOOGLE_CLOUD_PROJECT=REPLACE_WITH_GCP_PROJECT_ID
GOOGLE_CLOUD_LOCATION=global
GCS_BUCKET=REPLACE_WITH_PRIVATE_GCS_BUCKET

JWT_HS256_SECRET_BASE64=REPLACE_WITH_A_32_BYTE_OR_LONGER_BASE64_SECRET
JWT_ISSUER=mulgil-api
JWT_AUDIENCE=mulgil-mobile
JWT_KEY_ID=prod-v1
GOOGLE_OAUTH_CLIENT_ID=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID

SPEECH_LOCATION=us
SPEECH_API_ENDPOINT=us-speech.googleapis.com
SPEECH_MODEL=chirp_3
VERTEX_GENERATION_MODEL=gemini-2.5-flash
VERTEX_EMBEDDING_MODEL=text-multilingual-embedding-002
VERTEX_EMBEDDING_LOCATION=us-central1
VERTEX_EMBEDDING_BATCH_SIZE=5
VERTEX_GENERATION_TEMPERATURE=0.1
VERTEX_GENERATION_CANDIDATE_COUNT=1
VERTEX_GENERATION_SUMMARY_MAX_OUTPUT_TOKENS=8192
VERTEX_GENERATION_MINDMAP_MAX_OUTPUT_TOKENS=8192
# Applied only when the requested model ID is exactly gemini-2.5-flash and the artifact is a mindmap.
# Summary, quiz, and other configured/benchmark models keep their provider-default thinking behavior.
# Valid: 0..24576 and less than VERTEX_GENERATION_MINDMAP_MAX_OUTPUT_TOKENS.
VERTEX_GENERATION_MINDMAP_THINKING_BUDGET=1024
VERTEX_GENERATION_QUIZ_MAX_OUTPUT_TOKENS=8192
VERTEX_GENERATION_TOTAL_TIMEOUT_SECONDS=180
VERTEX_GENERATION_INPUT_SOFT_TOKEN_LIMIT=100000
VERTEX_GENERATION_CONTEXT_CACHE_ENABLED=false
VERTEX_GENERATION_CONTEXT_CACHE_TTL_SECONDS=3600
VERTEX_MODEL_BENCHMARK_ENABLED=false
VERTEX_MODEL_BENCHMARK_CANDIDATES=
VERTEX_MODEL_BENCHMARK_RETENTION_DAYS=30
SELECTED_TOPIC_GENERATION_ENABLED=false
SELECTED_TOPIC_MAX_TOP_K=20
SELECTED_TOPIC_CANDIDATE_MULTIPLIER=8
SELECTED_TOPIC_METRIC_RETENTION_DAYS=30
FCM_ENABLED=true
